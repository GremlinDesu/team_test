#REDIS
REDIS_ADDR = "localhost:6379"
REDIS_USER = ""
REDIS_PASSWORD = ""
REDIS_PROTO = 3

#MYSQL
MYSQL_ROOT = "root"
MYSQL_DB = "teams_db"
MYSQL_USER = "user"
MYSQL_PASSWORD = "password"
MYSQL_DSN = "user:password@tcp(127.0.0.1:3306)/teams_db?parseTime=true"
#GOOSE
GOOSE_DRIVER=mysql
GOOSE_DBSTRING=root:root@tcp(127.0.0.1:3306)/teams_db?parseTime=true
GOOSE_MIGRATION_DIR=./migrations
GOOSE_TABLE=teams_db.goose_migrations

#AUTH
AUTH_JWT_EXPIRE=10m
AUTH_REFRESH_EXPIRE=1h
AUTH_SECRET=testing